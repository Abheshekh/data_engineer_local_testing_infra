# Volume Paths — local directories that are mounted into containers
# NOTEBOOK_WORK_PATH: maps to /home/jovyan/work — point this at your local projects folder
NOTEBOOK_WORK_PATH=your-notebook-work-path-here
# VOLUMES_BASE_PATH: parent folder for s3/, delta/, mongodb/ subdirectories
VOLUMES_BASE_PATH=your-volumes-base-path-here

# AWS Credentials (used by LocalStack - keep as "test" for local development)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-west-2

# LocalStack Auth Token
# Required to run LocalStack Pro features (S3, SSM, Lambda, etc.)
# How to get it:
#   1. Register at https://app.localstack.cloud/sign-up
#   2. Log in and go to Workspace → Auth Token
#   3. Copy the token and paste it below
LOCALSTACK_AUTH_TOKEN=your-localstack-auth-token-here

# MongoDB Credentials
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=mongo_pass
